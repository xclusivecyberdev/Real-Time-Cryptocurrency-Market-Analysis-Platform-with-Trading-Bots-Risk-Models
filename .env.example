# Application Settings
APP_NAME=CryptoMarketAnalysisPlatform
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Database
DATABASE_URL=postgresql+asyncpg://crypto_user:crypto_pass@localhost:5432/crypto_platform
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=300

# TimescaleDB (if separate from main DB)
TIMESCALE_URL=postgresql://crypto_user:crypto_pass@localhost:5432/crypto_timeseries

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ENCRYPTION_KEY=your-32-byte-base64-encoded-encryption-key

# Exchange API Keys (Optional - for live trading)
# Binance
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# Bybit
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true

# Coinbase
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_PASSPHRASE=

# Kraken
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# KuCoin
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_PASSPHRASE=

# WebSocket Settings
WS_RECONNECT_DELAY=5
WS_MAX_RECONNECT_ATTEMPTS=10
WS_PING_INTERVAL=30

# Trading Settings
PAPER_TRADING=true
DEFAULT_LEVERAGE=1
MAX_POSITION_SIZE=10000
COMMISSION_RATE=0.001

# Risk Management
MAX_DRAWDOWN_PERCENT=20
POSITION_SIZE_METHOD=kelly
RISK_PER_TRADE_PERCENT=2
VAR_CONFIDENCE_LEVEL=0.95

# Backtesting
BACKTEST_INITIAL_CAPITAL=10000
BACKTEST_COMMISSION=0.001
BACKTEST_SLIPPAGE=0.0005

# ML Models
ML_MODEL_PATH=./ml/models/saved
ML_RETRAIN_INTERVAL_HOURS=24
LSTM_EPOCHS=100
PROPHET_PERIODS=30

# Alerts
ENABLE_ALERTS=true

# Email
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@cryptoplatform.com

# Telegram
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SMS (Twilio)
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
ALERT_PHONE_NUMBERS=

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# Data Retention
KEEP_TICK_DATA_DAYS=7
KEEP_1M_CANDLES_DAYS=30
KEEP_5M_CANDLES_DAYS=90
KEEP_1H_CANDLES_DAYS=365
KEEP_1D_CANDLES_DAYS=1825

# Feature Flags
ENABLE_ML_PREDICTIONS=true
ENABLE_LIVE_TRADING=false
ENABLE_ADVANCED_ANALYTICS=true
ENABLE_ARBITRAGE_DETECTION=true
